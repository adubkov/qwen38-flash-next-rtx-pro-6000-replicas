# Copy to .env beside compose.yaml (docker compose reads ./.env automatically) and
# fill in. These are the values this recipe cannot ship: the engine build is a
# third-party SM120 fork we do not redistribute, and a GPU UUID identifies one
# specific card on one specific machine.
#
# Nothing here has a default in compose.yaml on purpose — compose aborts naming the
# variable rather than starting a replica on an empty image or someone else's card.

# Any SM120-capable SGLang-class build you are entitled to use. The open-source
# image is lmsysorg/sglang on Docker Hub; compose's own fallback points at its
# v0.5.19-cu130 digest, which is the version/CUDA lane we measured on BUT is not the
# vendor fork our numbers came from, so it will not serve this checkpoint's NVFP4 +
# shared-PLE flags. See LICENSING.md.
#ENGINE_IMAGE=lmsysorg/sglang@sha256:d6e7288627be8b02be88e4bba38e73f6d50e2826869f753c13a4c4385ab3eda9
ENGINE_IMAGE=

# One card per replica, never "all" — that is what makes the two replicas provably
# distinct, and the plugin's gates refuse to run without a named card.
# Get yours: nvidia-smi -L
GPU_UUID_A=
GPU_UUID_B=
